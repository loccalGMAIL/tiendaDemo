includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    # Lee los casts() de los modelos (enums, array, boolean) del código en vez del PHPDoc.
    parseModelCastsMethod: true
    paths:
        - app
        - database
        - routes
        # Los traits de módulo se analizan en el contexto de las clases que los usan.
        - tests/Fixtures
