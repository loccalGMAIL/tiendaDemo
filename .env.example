APP_NAME="Nombre del negocio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://app.negocio.localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=negocio
DB_USERNAME=root
DB_PASSWORD=

# Cada host tiene su propia sesión: no se comparte entre paneles
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Dominios (config/domains.php). Ningún host va escrito en el código.
LANDING_DOMAIN=negocio.localhost
PANEL_DOMAIN=app.negocio.localhost
SUPERADMIN_DOMAIN=plataforma.negocio.localhost

# Proxy con SSL delante de la app: IPs/CIDR separadas por coma, o * para confiar en todos.
TRUSTED_PROXIES=*

# Usuarios iniciales (los crea el seeder; se pueden volver a correr sin duplicar)
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=
SUPERADMIN_NAME=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Módulo Login con Google (vacío = el módulo no se puede habilitar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="https://${PANEL_DOMAIN}/auth/google/callback"

# En producción además: APP_ENV=production, APP_DEBUG=false,
# SESSION_SECURE_COOKIE=true, LOG_LEVEL=warning
